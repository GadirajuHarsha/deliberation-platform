# Backend Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Your Google AI Studio API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: GCP project ID (used for Vertex AI if switching from AI Studio)
# PROJECT_ID=your_gcp_project_id

# Optional: Override database directory (defaults to current directory)
# Cloud Run sets this to /tmp for the ephemeral SQLite instance.
# DB_DIR=/tmp

# Frontend Environment Configuration
# Copy this file to .env.live (for the authenticated live build) and fill in your values.
# NEVER commit .env.live or .env.demo to version control.

# Set to false for the live authenticated environment, true for mock/demo mode
VITE_MOCK_AUTH=false

# The base URL of your deployed FastAPI backend
VITE_API_URL=https://your-cloud-run-service-url.run.app

# App mode: "auth" for live, "demo" for mock/presentation mode
VITE_APP_MODE=auth
